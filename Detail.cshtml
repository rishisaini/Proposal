    const getSubProgramUrl = '@Url.RouteUrl("DefaultApi", new {httproute = "", controller = "Proposal"})/GetSubProgram?programId=';
    $('#programSelectList').change(function () {
        changeSubProgramList(getSubProgramUrl)
    });

    changeSubProgramList = function (url) {
        let subProgram = $('#subProgramSelectList');
        subProgram.empty();
        $.getJSON(url + $("#programSelectList").val(),
            function (data) {
                if (!data) {
                    return;
                }
                subProgram.append($('<option></option>').val('0').text('---Select---'));
                $.each(data,
                    function (index, item) {
                        subProgram.append($('<option></option>').val(item.Value).text(item.Text));
                    });
            });
    };


