@section Scripts
{

    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/respond.js/1.4.2/respond.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/tempusdominus-bootstrap-4/5.0.1/js/tempusdominus-bootstrap-4.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tempusdominus-bootstrap-4/5.0.1/css/tempusdominus-bootstrap-4.min.css" />


    <style type="text/css">
        .validation-summary-valid {
            display: none;
        }

        a[disabled="disabled"] {
            pointer-events: none;
        }

        .field-validation-valid {
            display: none;
        }

        .validation-summary-errors, .validation-summary-errors1, .validation-summary-errors2, .validation-summary-errors3 {
            display: block;
            color: red;
        }
        /* Validation */
        .input-validation-error {
            border-color: red !important;
        }

        .field-validation-error {
            font-size: 10px;
            float: right;
            padding-top: 6px;
            color: red !important;
        }

        .input-validation-error ~ .select2 .select2-selection {
            border: 1px solid red;
        }

        .btn-outline-info.disabled, .btn-outline-info:disabled {
            background-color: #5a7ca4;
        }


        [type=checkbox].filled-in:not(:checked) + label:after  {
            background-color: #FFFFFF;
        }

        .modal-dialog,
        .modal-content {
            /* 80% of window height */
        }

        .modal-body {
            /* 100% = dialog height, 120px = header + footer */
            max-height: calc(100% - 120px);
        }

        .modal-header {
            border-top-left-radius: 10px !important;
            border-top-right-radius: 10px !important;
        }

        @@media (min-width: 348px) and (max-width: 720px) {
            .label-bdr {
                padding-bottom: 8px !important;
            }
        }

        .no-close .ui-dialog-titlebar-close {
            display: none
        }

        .w-32em {
            width: 32em;
        }
        /* === Overlay === */
        .ui-widget-overlay {
            background: #000;
            opacity: 0.6;
        }

        /* === Outer Dialog === */
        .defect-convert-dialog.ui-dialog {
            border: 1px solid #2c3e50;
            border-radius: 6px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.4);
            padding: 0;
            font-family: Arial, sans-serif;
        }

        /* === Title Bar === */
        .defect-convert-dialog .ui-dialog-titlebar {
            background: #2c3e50;
            color: #ffffff;
            font-size: 14px;
            font-weight: bold;
            padding: 12px 15px;
            border-radius: 4px 4px 0 0;
            border: none;
        }

        /* === Hide X Close Button === */
        .defect-convert-dialog .ui-dialog-titlebar-close {
            display: none;
        }

        /* === Dialog Body === */
        .defect-convert-dialog .ui-dialog-content {
            padding: 20px 15px;
            font-size: 13px;
            color: #333;
            background: #fff;
            line-height: 1.5;
            display: block; /* ✅ changed from flex to block */
        }

        /* === Button Panel === */
        .defect-convert-dialog .ui-dialog-buttonpane {
            background: #f5f5f5;
            border-top: 1px solid #ddd;
            padding: 10px 15px;
            margin: 0;
        }

        .defect-convert-dialog .ui-dialog-buttonset {
            float: right;
        }

        /* === All Buttons Base === */
        .defect-convert-dialog .ui-dialog-buttonpane button {
            padding: 7px 18px;
            font-size: 13px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            margin-left: 8px;
            transition: background 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .defect-convert-dialog .ui-dialog-buttonpane button:first-child,
            .defect-convert-dialog .ui-dialog-buttonpane button:first-child:focus,
            .defect-convert-dialog .ui-dialog-buttonpane button:first-child:active {
                outline: none;
                border: none;
                box-shadow: none;
            }

            /* === Confirm Button (Green) === */
            .defect-convert-dialog .ui-dialog-buttonpane button:first-child {
                background: #29caff; /* <-- updated from #27ae60 to #29caff */
                color: #fff;
            }

                .defect-convert-dialog .ui-dialog-buttonpane button:first-child:hover {
                    background: #009efb;
                }

            /* === Cancel Button (Red) === */
            .defect-convert-dialog .ui-dialog-buttonpane button:last-child {
                background: #dca400;
                color: #fff;
            }

                .defect-convert-dialog .ui-dialog-buttonpane button:last-child:hover {
                    background: #ffc929;
                }

            /* === Button Icon spacing === */
            .defect-convert-dialog .ui-dialog-buttonpane button i {
                font-size: 13px;
                pointer-events: none;
            }
