@model AssetCare.Model.ViewModels.ProposalAddEditViewModel
@using AssetCare.Model.ViewModels
@using AssetCare.Model.Models
@using AssetCare.Helpers
@using Newtonsoft.Json
@using System.Configuration
@using AssetCare.Service
@{
    string InvalidFilenameCharacters = ConfigurationManager.AppSettings["InvalidFilenameCharacters"];
}
<div class="container-fluid">
    <!-- ============================================================== -->
    <!-- Bread crumb and right sidebar toggle -->
    <!-- ============================================================== -->
    @using (Html.BeginForm("Detail", "Proposals", FormMethod.Post, new { id = "frmProposalDetails" }))
    {
        @Html.AntiForgeryToken()
        <div class="row" style="margin-top:-8px;">
            <div class="col-12">
                <div class="card white-bg">
                    <div class="row">
                        <div class="col-12 float-right mm-15">
                            <div class="col-lg-6 col-sm-12 float-left">
                                <h4><strong>Proposals Details</strong></h4>
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home", new { Area = "" })">Home</a></li>
                                    <li class="breadcrumb-item"><a href="#">Callouts</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Proposals", new { Area = "FMWorks" })">Proposals</a></li>
                                    <li href="#" class="breadcrumb-item active">Proposals Details</li>
                                </ol>
                            </div>
                            <div class="col-lg-6 col-sm-12 float-right" style="text-align:right;">
                                @{
                                    var cancelUrl = "/";
                                    if (string.IsNullOrEmpty(Model.CallbackUrl))
                                    {
                                        cancelUrl = Url.Action("Index", "Proposals");
                                    }
                                    else
                                    {
                                        cancelUrl = Model.CallbackUrl;
                                    }
                                }

                                @{
                                    if (Model.SelectedCallStatusId == 15) //Archived
                                    {
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20 readonly" type="button" disabled><span class="top-btn-label"><i class="fa fa-save"></i></span>Save</button>
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20 mr-2" type="button" disabled><span class="top-btn-label"><i class="fa fa-save"></i></span>Save and Exit</button>
                                    }
                                    else
                                    {

                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20" type="submit" id="btnSave" data-loading-text="<span class='top-btn-label'><i class='fa fa-circle-o-notch fa-spin'></i></span> Processing"><span class="top-btn-label"><i class="fa fa-save"></i></span>Save</button>
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20 mr-2 " type="submit" id="btnSubmit"><span class="top-btn-label"><i class="fa fa-save"></i></span>Save and Exit</button>
                                    }
                                }
                                <button id="btnCancel" class="top-btn btn-outline-info waves-effect waves-light tm-20" onclick="cancelButtonClicked(event,'@cancelUrl')" type="button"><span class="top-btn-label"><i class="fa fa-eraser"></i></span>Cancel</button>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" style="margin-bottom:15px!important">
            <div class="col-lg-6">
                @Html.Partial("_QuickHelp", Model)
            </div>
        </div>

        <div class="row" style="margin-top:-5px;">
            <div class="col-xl-12">
                <div class="card inner-border-2">
                    <div class="card-header" style="height: 44px;">
                        Proposal Details

                    </div>


                    <div class="card-body collapse show">
                        <div class="row" style="margin-top:-9px;">
                            <div class="col-12">
                                <div class="row top-ribbon" style="margin-top:0px!important;">
                                    <div class="col-xl-3 col-lg-4 col-sm-12  float-left mb1-mt1 mt-2">
                                        <i class="fa fa-edit fa-color"></i> <strong class="left-bdr">Proposal ID:</strong> <span>
                                            <strong>
                                                @{
                                                    if (Model.ProposalId == null || Model.ProposalId == 0)
                                                    {
                                                        <text><span style="color:red">Auto Generated Once Saved</span> </text>
                                                    }
                                                    else
                                                    {
                                                        <text>
                                                            @Model.ProposalId.ToString()
                                                        </text>
                                                    }
                                                }
                                            </strong>
                                        </span>
                                    </div>
                                    @Html.HiddenFor(x => x.AgencyId)
                                    @Html.HiddenFor(x => x.SchoolId)
                                    @Html.HiddenFor(x => x.PropertyId)
                                    @Html.HiddenFor(x => x.SchWorkCategory)
                                    @Html.HiddenFor(x => x.SelectedSchWorkCategoryId)
                                    @Html.HiddenFor(x => x.FormReadOnly)
                                    @Html.HiddenFor(x => x.FmcReadOnly)
                                    @Html.HiddenFor(x => x.CallOutId)
                                    @Html.HiddenFor(x => x.AcceptedFileTypes)
                                    @Html.HiddenFor(x => x.SchoolEmail)
                                    @Html.HiddenFor(x => x.PrincipalEmail)
                                    @Html.HiddenFor(x => x.SchoolName)
                                    @Html.HiddenFor(x => x.Area)
                                    @Html.HiddenFor(x => x.Phone)
                                    @Html.HiddenFor(x => x.mode)
                                    @Html.HiddenFor(x => x.AgencySequenceId)
                                    @Html.HiddenFor(x => x.JobId)
                                    @Html.HiddenFor(x => x.SaveType)
                                    @Html.HiddenFor(x => x.ProposalId)
                                    @Html.HiddenFor(x => x.showHideSection)
                                    @Html.HiddenFor(x => x.ReviewedDisbaled)
                                    @Html.HiddenFor(x => x.Entitlements.ValidateEntitlements)
                                    @Html.HiddenFor(x => x.ProposalRoles)
                                    @Html.HiddenFor(x => x.RoleID)
                                    @Html.HiddenFor(x => x.CurrentRoleID)
                                    @Html.HiddenFor(x => x.ConceptEstimateGST)
                                    @Html.HiddenFor(x => x.ASOEmail)
                                    @Html.HiddenFor(x => x.AwaitingActionBy)
                                    @Html.HiddenFor(x => x.ProposalWorkNominatedIDHidden)
                                    @Html.HiddenFor(x => x.SchoolFundedHidden)
                                    @Html.HiddenFor(x => x.UserIDPMASOHidden)
                                    @Html.HiddenFor(x => x.SubmitDisabled)
                                    @Html.HiddenFor(x => x.FundsAvailabilityDisabled)
                                    @Html.HiddenFor(x => x.SchoolRecurrentHidden)
                                    @Html.HiddenFor(x => x.SchoolRecurrent)
                                    @Html.HiddenFor(x => x.ProgramSelectListHidden)
                                    @Html.HiddenFor(x => x.UserEmail)
                                    @Html.HiddenFor(x => x.DeliveryTypeLRLV)
                                    @Html.HiddenFor(x => x.DeliveryTypeLRLVHidden)
                                    @Html.HiddenFor(x => x.DeliveryTypeAMU)
                                    @Html.HiddenFor(x => x.DeliveryTypeAMUHidden)
                                    @Html.HiddenFor(x => x.DeliveryTypeSSD)
                                    @Html.HiddenFor(x => x.DeliveryTypeSSDHidden)
                                    @Html.HiddenFor(x => x.CallLogFITSID)
                                    @Html.HiddenFor(x => x.CallLogSig)
                                    @Html.HiddenFor(x => x.SchoolSelfDeliveryHidden)
                                    @Html.HiddenFor(x => x.CommunityFunded)
                                    @Html.HiddenFor(x => x.CommunityFundedHidden)
                                    @Html.HiddenFor(x => x.AMUFunded)
                                    @Html.HiddenFor(x => x.AMUFundedHidden)
                                    @Html.HiddenFor(x => x.SchoolFunded)
                                    @Html.HiddenFor(x => x.DefaultProgramForLRLV)
                                    @Html.HiddenFor(x => x.SubmittedBy)
                                    @Html.HiddenFor(x => x.SubmittedtDate)
                                    @Html.HiddenFor(x => x.POCDocumentTypeID)
                                    @Html.HiddenFor(x => x.GrantApplicationHidden)
                                     @Html.HiddenFor(x => x.PlannedMaintenance)
                                      @Html.HiddenFor(x => x.PlannedMaintenanceHidden )
                                    @Html.Hidden("DisableRemoveFileDel", Model.DisableField("detailsection", "RemoveFileDel"))
                                    @{
                                        if (Model.SubmitDisabled)
                                        {
                                            @Html.HiddenFor(x => x.Rooms)
                                        }
                                    }
                                    <div class="col-xl-3 col-lg-4 col-sm-12  float-left mb1-mt1 mt-2">
                                        <i class="fa fa-address-book fa-color"></i> <strong class="left-bdr">School ID:</strong> <span>@Model.SchoolId </span>
                                        @Html.Partial("_SitePlan")
                                    </div>
                                    @if (Model.Submitted)
                                    {
                                        @Html.HiddenFor(x => x.Hazmat)
                                        @*@Html.HiddenFor(x => x.SchoolSelfDelivery)*@
                                    }


                                    <div class="col-xl-3 col-lg-4 col-sm-12 float-left mb1-mt1 mt-2">
                                        <i class="fa fa-user fa-color"></i> <strong class="left-bdr">ASO:</strong>
                                        <span>
                                            @Model.ASOName
                                        </span>
                                    </div>
                                    <div class="col-xl-3 col-lg-4 col-sm-12  float-left mb1-mt1 mt-2"><i class="fa fa-mobile-alt fa-color"></i> <strong class="left-bdr">Phone:</strong> <strong><a href="tel:@Model.Phone">@Model.Phone </a></strong> </div>
                                    <div class="col-xl-3 col-lg-4 col-sm-12  float-left mb1-mt1 mt-2"><i class="fa fa-map-marker fa-color" style="padding-right:4px;"></i> <strong class="left-bdr">Region:</strong> <span>@Model.Area </span> </div>
                                    <div class="col-xl-3 col-lg-4 col-sm-12  float-left mb1-mt1 mt-2"><i class="fa fa-building fa-color"></i> <strong class="left-bdr">School:</strong> <span>@Model.SchoolName </span> </div>
                                    <div class="col-xl-3 col-lg-4 col-sm-12  float-left mb1-mt1 mt-2">
                                        <i class="fa fa-phone fa-color"></i> <strong class="left-bdr">ASO Mobile:</strong>
                                        <span>
                                            <a href="tel:@Model.ASOContactNumber">@Model.ASOContactNumber </a>
                                        </span>
                                    </div>



                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <img src="~/theme2/assets/images/po.jpg" width="100%" height="67" alt="">
                        </div>
                        <div class="row" style="margin-top:30px;">
                            <div class="col-xl-12 col-lg-12" style="padding:0px;">
                                <div class="col-xl-3 col-lg-6 col-md-6 float-left">
                                    <div class="card" style="background: #fff; min-height: 290px; border-top: 3px solid #0c68fd !important; ">
                                        <div class="card-base " style=" background: #fff; padding-top: 6px; border-top-left-radius: 15px; border-top-right-radius: 20px; ">
                                            <div class="col">
                                                <div class="form-group align-self-center">
                                                    <label><strong>Principal Name</strong><span style="vertical-align: super; color:#d7153a;">*</span></label>
                                                    @Html.TextBoxFor(x => x.PrincipalName, new RouteValueDictionary(new { @class = "form-control form-control-sm" }).AddIf((Model.DisableField("schoolsection", "PrincipalName")), "disabled", "disabled"))
                                                    @{
                                                        if (!Model.CanEditFMCOnly)
                                                        {
                                                            @Html.HiddenFor(x => x.PrincipalName)
                                                        }
                                                    }
                                                    @Html.ValidationMessageFor(m => m.PrincipalName, string.Empty, new { style = "float:none" })
                                                </div>
                                            </div>
                                            <div class="col" style="margin-top:-14px; margin-left:0px;">
                                                <div class="form-group">
                                                    <label><strong>School Email</strong><span style="vertical-align: super; color:#d7153a;">*</span></label>
                                                    @Html.TextBoxFor(x => x.PrincipalEmail, new RouteValueDictionary(new { @class = "form-control form-control-sm" }).AddIf((Model.DisableField("schoolsection", "SchoolEmail")), "disabled", "disabled"))
                                                    @Html.ValidationMessageFor(m => m.PrincipalEmail, string.Empty, new { style = "float:none" })
                                                </div>
                                            </div>
                                            <div class="col" style="margin-top:0px; margin-left:0px;">
                                                <label><strong>Date Submitted</strong></label>
                                                <div class="input-group">
                                                    @{
                                                        var submittedDate = Model.SubmittedtDate.HasValue ? Model.SubmittedtDate.Value.ToString("dd/MM/yyyy") : string.Empty;

                                                    }
                                                    <input type="text" class="form-control form-control-sm" id="submittedDate" name="jobCreatedDate" value="@submittedDate" readonly>
                                                    <div class="input-group-append" style="height: 33px;">
                                                        <span class="input-group-text mr-2" id="basic-addon1">
                                                            <img src="@Url.Content("~/theme2/assets/images/350.png")" style="height:20px;">
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 float-left">
                                    <div class="card inner-border-2" style="background: #fff; min-height: 290px; border-top: 3px solid #0c68fd !important; ">
                                        <div class="card-base" style=" background: #fff; padding-top: 6px; padding-bottom: 6px; border-top-left-radius: 20px; border-top-right-radius: 20px; ">
                                            <div class="col">
                                                <div class="form-group float-left" style=" margin-top:8px; margin-left:0px; margin-bottom:8px;">
                                                    <label><strong>Date and Time Reported</strong> <span class="ml-1 label-desc"> (24-hr Format HH:MM)</span></label>
                                                    <div class="input-group w-100 ed-4">
                                                        @Html.EditorFor(m => m.ProposalDate, new
                                                   {
                                                       htmlAttributes = new RouteValueDictionary(new
                                                       {
                                                           @placeholder = "dd/mm/yyyy",
                                                           @class = "form-control form-control-sm datepicker-control",
                                                           @Value = ((Model.ProposalDate.HasValue) ? Model.ProposalDate.Value.ToString("dd/MM/yyyy") : ""),
                                                           id = "txtCallDate",

                                                       }).AddIf(Model.mode == "edit", "disabled", "disabled")
                                                   })
                                                        @{
                                                            if (Model.mode == "edit")
                                                            {
                                                                @Html.HiddenFor(x => x.ProposalDate)
                                                                @Html.HiddenFor(x => x.CallLogTime)

                                                            }
                                                        }
                                                        <div class="input-group-append datepicker-control-sibling" style="height: 33px;">
                                                            <span class="input-group-text mr-2" id="basic-addon1">
                                                                <img src="@Url.Content("~/theme2/assets/images/350.png")" class="datepicker-control-img" style="height:20px;">
                                                            </span>
                                                        </div>

                                                        <div class="sm-1">
                                                            <div class="row ml-2 date" id="tpIncidentFrom" data-target-input="nearest">
                                                                @{
                                                                    if (Model.FormReadOnly || Model.mode == "edit")
                                                                    {
                                                                        <input id="CallLogTime" name="CallLogTime" type="text" class="form-control datetimepicker-input" style="width:60px" data-target="#tpIncidentFrom" Value="@((Model.CallLogTime.HasValue) ? Model.CallLogTime.Value.ToString("HH:mm") : "")" placeholder="" data-val-required="'Incident Time' is required" data-val="true" readonly />

                                                                    }
                                                                    else
                                                                    {
                                                                        <input id="CallLogTime" name="CallLogTime" type="text" class="form-control datetimepicker-input dtTimeWidth" style="width:60px" data-target="#tpIncidentFrom" onchange="callLogTimeChanged();" Value="@((Model.CallLogTime.HasValue) ? Model.CallLogTime.Value.ToString("HH:mm") : "")" placeholder="" data-val-required="'Incident Time' is required" data-val="true" />
                                                                    }
                                                                    <button type="button" class="btn btn-info h-32" id="btnSetCurrentDate" style="margin-left:5px"><i class="mdi mdi-update iem" style="font-size:18px; display: flex; justify-content: center;"></i></button>

                                                                }

                                                            </div>
                                                        </div>
                                                    </div>
                                                    @{
                                                        if (!(Model.FormReadOnly || Model.mode == "edit"))
                                                        {
                                                            @Html.ValidationMessageFor(m => m.ProposalDate, null, new { @style = "float:left" })
                                                            <text>&nbsp;&nbsp;</text>
                                                            <span class="field-validation-error" id="dateTimeMsg" style="float:right"></span>
                                                            <text>&nbsp;&nbsp;</text>
                                                            @Html.ValidationMessageFor(m => m.CallLogTime, string.Empty, new { @style = "float:right" })
                                                        }
                                                    }
                                                </div>
                                            </div>

                                            <div class="col" style="margin-left:-18px;">
                                                <div class="col-xl-12 col-lg-12 col-md-12">
                                                    <label style="margin-top:10px;"><strong>Proposal Status</strong></label>
                                                    @Html.DropDownListFor(x => x.SelectedCallStatusId, (IEnumerable<SelectListItem>
    )ViewData["ProposalStatus"], "---Select---",
    new RouteValueDictionary(new { @class = "custom-select", @id = "callLogTypeSelectList" }).AddIf((Model.DisableField("schoolsection", "ProposalStatus")), "disabled", "disabled"))
                                                    <text>&nbsp;&nbsp;</text>
                                                    <span class="field-validation-error" id="proposalstatusmsg" style="float:right;font-size:11px">Submitted must be selected</span>
                                                    <text>&nbsp;&nbsp;</text>
                                                    @{
                                                        if (Model.FmcReadOnly || Model.showHideSection)
                                                        {
                                                            @Html.HiddenFor(x => x.SelectedCallStatusId)
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <div class="col" style="margin-left:-18px;">
                                                <div class="col-xl-12 col-lg-12 col-md-12">
                                                    <label for="blah" style="margin-top:10px;"><strong>Asset Management PM</strong></label><span style="vertical-align: super; color:#d7153a;"></span>
                                                    <div class="input-group">
                                                        @Html.DropDownListFor(x => x.UserID, (IEnumerable<SelectListItem>
    )ViewData["PMASO"], "---Select---",
    new RouteValueDictionary(new { @class = "custom-select", @id = "pmASO" }).AddIf((Model.DisableField("detailsection", "pmaso")), "disabled", "disabled"))
                                                        <br>
                                                    </div>
                                                </div>
                                            </div>


                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 float-left">

                                    <div class="card inner-border-2" style="background: #fff; min-height: 290px; border-top: 3px solid #0c68fd !important; ">
                                        <div class="card-base" style=" background: #fff; padding-top: 6px; padding-bottom: 6px; border-top-left-radius: 20px; border-top-right-radius: 20px; ">
                                            <div class="row" style=" padding-top: 6px; padding-bottom: 6px;  margin-left:19px; margin-right:1px;">
                                                <div class="col-xl-7 col-lg-7 col-md-7 float-left mt-7">
                                                    <div style="margin-left:-5px;">
                                                        <strong style="padding-top:3px;">
                                                            <u>Funding Options</u>
                                                            <button type="button" class="btn-sm btn-rounded " data-toggle="popover" data-content="If School and Community Funded is flagged as 'Yes', it can be changed by the school. Remember that proposals from other funding sources take longer to approve and initiate." style="vertical-align: middle; border: none; box-shadow: none; margin-left:5px; padding: 0px 8px 1px 7px; background: #2196f3; margin-right:10px !important; " data-original-title="" title=""><i class="fa fa-info" style=" color: white; font-size: 11px !important;"></i></button>
                                                        </strong>
                                                    </div>
                                                </div>
                                                <div class="col-lg-5 col-sm-12 float-right" style="text-align: right; ">
                                                    <div class="input-group" style="background: #eeeeee; padding: 6px; border-radius: 10px;margin-top:0px; font-size: 14px; font-weight:600; width:210px; ">
                                                        @Html.CheckBoxFor(p => p.GrantApplication, new RouteValueDictionary(new { @class = "filled-in chk-col-light-blue q " }).AddIf(Model.DisableField("detailsection", "GrantApplication"), "disabled", "disabled"))
                                                        @Html.LabelFor(model => model.GrantApplication, new { @style = "margin-bottom:5px;height:0px !important;line-height:20px !important" })
                                                        <button type="button" class="btn-sm btn-rounded " data-toggle="popover" data-content="Tick this checkbox to flag proposal as a Grant Application. Flagging could be done prior to ASO's review and approval." style="vertical-align: middle; border: none; box-shadow: none; margin-left:5px; padding: 0px 8px 1px 7px; background: #2196f3; margin-right:10px !important; " data-original-title="" title="">
                                                            <i class="fa fa-info" style=" color: white; font-size: 11px !important;"></i>
                                                        </button>


                                                        @*<button type="button" class="btn-sm btn-rounded " data-toggle="popover" data-html="true" data-content="Tick this checkbox to flag proposal as a Grant Application. Flagging could be done prior to ASO's review and approval." style="vertical-align: middle; border: none; box-shadow: none; margin-left:5px; padding: 1px 8px 1px 8px; background: #2196f3; " data-original-title="" title="">
                                                                <i class="fa fa-info" style=" color: white; font-size: 11px !important;"></i>
                                                            </button>*@
                                                    </div>

                                                </div>

                                            </div>
                                            <div class="row" style="margin-left: -2px; margin-top: -5px;">
                                                <div class="col-xl-12 col-lg-12 col-md-12 float-left mt-4">


                                                    <div style="margin-left:-5px;" id="divSchoolFunded">
                                                        <span>
                                                            <span class="ml-1">
                                                                @Html.RadioButtonFor(m => m.SchoolFunded, "True", new RouteValueDictionary(new { @id = "schoolFunded", @name = "schoolFunded", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("detailsection", "schoolFunded"), "disabled", "disabled"))
                                                                <label for="schoolFunded" style="margin-right:10px; font-size:14px; font-weight: 500 !important;">School Funded</label>
                                                                @Html.RadioButtonFor(m => m.CommunityFunded, "True", new RouteValueDictionary(new { @id = "communityFunded", @name = "communityFunded", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("detailsection", "communityFunded"), "disabled", "disabled"))
                                                                <label for="communityFunded" style="margin-right:10px; font-size:14px; font-weight: 500 !important;">Community Funded</label>
                                                                @Html.RadioButtonFor(m => m.AMUFunded, "True", new RouteValueDictionary(new { @id = "amuFunded", @name = "amuFunded", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("detailsection", "amuFunded"), "disabled", "disabled"))
                                                                <label for="amuFunded" style="margin-right:10px; font-size:14px; font-weight: 500 !important;">DoE Funded</label>
                                                                 @Html.RadioButtonFor(m => m.PlannedMaintenance, "True", new RouteValueDictionary(new { @id = "plannedMaintenance", @name = "plannedMaintenance", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("detailsection", "plannedMaintenance"), "disabled", "disabled"))
        <label for="plannedMaintenance" style="margin-right:10px; font-size:14px; font-weight: 500 !important;">Planned Maintenance</label> 
                                                            </span>
                                                        </span>
                                                    </div>
                                                </div>


                                            </div>
                                            <div class="row mt-3" style="margin-left: -12px; margin-right: -12px;">

                                                <div class="col-xl-12 col-lg-12 col-md-12 ">
                                                    <div class="col-6 float-left">

                                                        <label for="blah" style="margin-top:10px;"><strong>Funding source</strong></label><span style="vertical-align: super; color:#d7153a;"></span>
                                                        <div class="input-group">
                                                            @Html.DropDownListFor(x => x.ProposalSFCID, (IEnumerable<SelectListItem>)ViewData["ProposalSFC"],
    new RouteValueDictionary(new { @class = "custom-select", @id = "schoolFundCode" }).AddIf((Model.DisableField("detailsection", "Schoolfundcode")), "disabled", "disabled"))
                                                            @{
                                                                if (!Model.showHideSection || Model.showHideSDEDSection)
                                                                {
                                                                    @Html.HiddenFor(x => x.ProposalSFCID)
                                                                }
                                                            }

                                                        </div>
                                                        @Html.ValidationMessageFor(x => x.ProposalSFCID, string.Empty, new { style = "float:none" })

                                                    </div>
                                                    <div class="col-6 float-left">
                                                        <label for="blah" style="margin-top:30px;"><strong></strong></label><span style="vertical-align: super; color:#d7153a;"></span>
                                                        <div class="input-group">
                                                            @Html.CheckBoxFor(p => p.SchoolSelfDelivery, new RouteValueDictionary(new { @class = "filled-in chk-col-light-blue q " }).AddIf(Model.DisableField("detailsection", "SchoolSelfDelivery"), "disabled", "disabled"))
                                                            @Html.LabelFor(model => model.SchoolSelfDelivery, new { @style = "font-size:14px;margin-bottom:5px;" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row mt-3" style="margin-left: -12px; margin-right: -12px;">

