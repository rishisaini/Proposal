@model AssetCare.Model.ViewModels.CallOutAddEditViewModel
@using AssetCare.Model.ViewModels
@using AssetCare.Helpers
@using Newtonsoft.Json
@using System.Configuration
@using AssetCare.Common
@using AssetCare.Service
@{
    string Google_apiKey = ConfigurationManager.AppSettings["Google_apiKey"];
    var totalEstimationOverLimitThresholdText = CalloutSharedFunctions.GetTotalEstimationThresholdText();
    var isTotalEstimationOverLimitLable = $"Is total estimated cost over ${totalEstimationOverLimitThresholdText} ?";
    string InvalidFilenameCharacters = ConfigurationManager.AppSettings["InvalidFilenameCharacters"];
}
<div class="container-fluid">
    <!-- ============================================================== -->
    <!-- Bread crumb and right sidebar toggle -->
    <!-- ============================================================== -->
    @{
        string callDescHeight = "121px";
        string leftPanelHeight = "350px";
        if (!Model.DisableField("mainSection", "hideControls"))
        {
            leftPanelHeight = "310px";
            callDescHeight = "78px";
        }
    }

    @using (Html.BeginForm("Detail", "CallOut", FormMethod.Post, new { id = "frmCalloutDetails" }))
    {
        @Html.AntiForgeryToken()
        <div class="row" style="margin-top:-8px;">
            <div class="col-12">
                <div class="card white-bg">

                    <div class="row">
                        <div class="col-12 float-right mm-15">
                            <div class="col-lg-6 col-sm-12 float-left">
                                @if (Model.CapitalDefect)
                                {
                                    <h4><strong>Capital Defects Details</strong></h4>
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item float-left"><a href="@Url.Action("Index", "Home", new { Area = "" })">Home</a></li>
                                        <li class="breadcrumb-item"><a href="#">Callouts</a></li>
                                        <li class="breadcrumb-item"><a href="@Url.Action("DefectListIndex", "Defect", new { Area = "FMWorks" })">Capital Defects</a></li>
                                        <li href="#" class="breadcrumb-item active">Capital Defects Details</li>
                                    </ol>
                                }
                                else
                                {
                                    <h4><strong>Reactive Callout Details</strong></h4>
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item float-left"><a href="@Url.Action("Index", "Home", new { Area = "" })">Home</a></li>
                                        <li class="breadcrumb-item"><a href="#">Callouts</a></li>
                                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "CallOut", new { Area = "FMWorks" })">Reactive Callouts</a></li>
                                        <li href="#" class="breadcrumb-item active">Reactive Callout Details</li>
                                    </ol>
                                }
                            </div>
                            <div class="col-lg-6 col-sm-12 float-right" style="text-align:right;">
                                @{
                                    var cancelUrl = "/";
                                    if (Model.CapitalDefect || User.IsInRoles("PROJECTMNGR,PROJECTDIR"))
                                    {
                                        cancelUrl = Url.Action("DefectListIndex", "Defect");
                                    }
                                    else if (string.IsNullOrEmpty(Model.CallbackUrl))
                                    {
                                        cancelUrl = Url.Action("Index", "Callout");
                                    }
                                    else
                                    {
                                        cancelUrl = Model.CallbackUrl;
                                    }
                                }

                                @{
                                    if (Model.ShowSave)
                                    {
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20  mr-2" type="submit" id="btnSave"><span class="top-btn-label"><i class="fa fa-save"></i></span>Save</button>
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20 mr-2" type="submit" id="btnSaveAndClose"><span class="top-btn-label"><i class="fa fa-save"></i></span>Save and Exit</button>
                                    }
                                    else
                                    {
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20  mr-2" type="submit" id="btnSave" disabled><span class="top-btn-label"><i class="fa fa-save"></i></span>Save</button>
                                        <button class="top-btn btn-outline-info waves-effect waves-light tm-20 mr-2" type="submit" id="btnSaveAndClose" disabled><span class="top-btn-label"><i class="fa fa-save"></i></span>Save and Exit</button>
                                    }
                                }
                                <button id="btnCancel" class="top-btn btn-outline-info waves-effect waves-light tm-20" onclick="cancelButtonClicked(event,'@cancelUrl')" type="button"><span class="top-btn-label"><i class="fa fa-eraser"></i></span>Cancel</button>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="row" style="margin-bottom:15px!important">
            <div class="col-lg-6">
                @Html.Partial("_QuickHelp", Model)
            </div>
        </div>
        @*<div class="row" style="margin-bottom:15px!important">
                <div class="col-lg-6 col-sm-12">
                    <p class="text-danger">
                        @Html.ValidationSummary()
                    </p>
                </div>
            </div>*@
        <div class="row" style="margin-top:-12px;">
            <div class="col-12">
                <div class=" blue-header">
                    <div class="card-header" style="padding-left:0px"><strong>Details</strong></div>
                </div>
            </div>
        </div>


        <div class="row" style="margin-top:-12px;">
            <div class="col-xl-12">
                <div class="card">

                    <div class="card-body collapse show mt-0">
                        <div class="row top-ribbon">
                            <div class="col-lg-2 col-sm-12  float-left mb1-mt1 mt-2">
                                <i class="fa fa-edit fa-color"></i> <strong class="left-bdr">Callout ID:</strong>
                                @{
                                    if (Model.CallOutId == null || Model.CallOutId == 0)
                                    {
                                        <text><span style="color:red">Auto Generate</span> </text>
                                    }
                                    else
                                    {
                                        <text>
                                            @Model.AgencySequenceID.ToString()
                                        </text>
                                    }
                                }

                            </div>

                            <div class="col-lg-4 col-sm-12 float-left mb1-mt1 mt-2">
                                <i class="fa fa-map-marker fa-color right-bdr" style="float:left;"></i>

                                <button style="float: left; margin-left: 4px; background: none; border: none; font-weight: bold; color: #007bff;" id="mapPreviewButton" type="button" data-toggle="modal" data-target=".bs-map-modal">@Model.SchoolName</button>


                            </div>

                            <div class="col-lg-3 col-sm-12  float-left mb1-mt1 mt-2">
                                <i class="fa fa-building fa-color"></i> <strong class="left-bdr">School ID:</strong> <span> @Model.SchoolId </span>
                                @Html.Partial("_SitePlan")
                            </div>
                            <div class="col-lg-3 col-sm-12  float-left mb1-mt1 mt-2"><i class="fa fa-phone fa-color fa-color"></i> <strong class="left-bdr">Phone:</strong> <strong><a href="tel:@Model.Phone">@Model.Phone </a></strong></div>
                            <div class="col-lg-2 col-sm-12  float-left mb1-mt1 mt-2 "><i class="fa fa-user-circle fa-color"></i> <strong class="left-bdr">ASO:</strong> @Model.ASOName </div>
                            <div class="col-lg-4 col-sm-12 float-left mb1-mt1 mt-2"><i class="fa fa-mobile-alt fa-color"></i> <strong class="left-bdr">ASO Mobile:</strong> <strong><a href="tel:@Model.ASOContactNumber">@Model.ASOContactNumber </a></strong></div>
                            <div class="col-lg-3 col-sm-12  float-left mb1-mt1 mt-2 "><i class="fa fa-user-circle fa-color"></i> <strong class="left-bdr">Group Leader (GL):</strong> @Model.GLName </div>
                            <div class="col-lg-3 col-sm-12 float-left mb1-mt1 mt-2"><i class="fa fa-mobile-alt fa-color"></i> <strong class="left-bdr">GL Mobile:</strong> <strong><a href="tel:@Model.GLContactNumber">@Model.GLContactNumber </a></strong></div>
                            <div class="col-lg-2 col-sm-12  float-left mb1-mt1 mt-3">
                                <i class="fa fa-flag fa-color fa-color" title="High Risk"></i> <strong class="left-bdr">High Risk:</strong>
                                <strong>
                                    @{
                                        if (Model.AsbestosHR == true)
                                        {

                                            <a style="color: red;">Yes</a>

                                        }
                                        else
                                        {
                                            <a style="color: green;">No</a>
                                        }
                                    }
                                </strong>
                            </div>
                            @{
                                if (Model.DefectMgmt == true)
                                {
                                    <div class="col-lg-3 col-sm-12  float-left mb1-mt1 mt-3">
                                        <strong>
                                            <i class="fa fa-wrench fa-color" title="Capital Defect" style="font-size: 15px;"></i>  <span class="left-bdr" style="margin-left:3px;background-color: #29caff;color:white;padding:5px;border-radius:8px;">Capital Defect</span>
                                        </strong>
                                    </div>
                                }
                            }
                            @{
                                if (Model.ProposalId > 0)
                                {
                                    <div class="col-lg-3 col-sm-12  float-left mb1-mt1 mt-3">
                                        <strong>
                                            <i class="fa fa-edit fa-color" title="LRLV Id" style="margin-left:-7px;"></i>  <span class="left-bdr">LRLV Id: </span>
                                        </strong>
                                        @if (Model.CurrentRoleID == "C" || Model.CurrentRoleID == "LC")
                                        {
                                            <a style="color: #007bff"> @Model.ProposalId.ToString()</a>

                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Detail", "Proposals", new { Area = "FMWorks" })?id=@Model.ProposalId&sig=@Model.SigProposal"> @Model.ProposalId.ToString()</a>
                                        }


                                    </div>
                                    @*@Html.HiddenFor(x => x.CallLogDesc)*@
                                }
                            }

                        </div>
                        @Html.HiddenFor(x => x.AgencyID)
                        @Html.HiddenFor(x => x.SchoolId)
                        @Html.HiddenFor(x => x.PropertyID)
                        @Html.HiddenFor(x => x.WorkCategoryID)
                        @Html.HiddenFor(x => x.CallOutId)
                        @Html.HiddenFor(x => x.AcceptedFileTypes)
                        @Html.HiddenFor(x => x.SchoolEmail)
                        @Html.HiddenFor(x => x.SchoolName)
                        @Html.HiddenFor(x => x.Area)
                        @Html.HiddenFor(x => x.Phone)
                        @Html.HiddenFor(x => x.mode)
                        @Html.HiddenFor(x => x.CallLogFITSID)
                        @Html.HiddenFor(x => x.AgencySequenceID)
                        @Html.HiddenFor(x => x.JobId)
                        @Html.HiddenFor(x => x.NewContractors)
                        @Html.HiddenFor(x => x.NewQuoteRequests)
                        @Html.HiddenFor(x => x.SchoolAddress)
                        @Html.HiddenFor(x => x.EmailAlertTypes)
                        @Html.HiddenFor(x => x.HAZMAT)
                        @Html.HiddenFor(x => x.CallLogTypeID)
                        @Html.HiddenFor(x => x.HasAtleastOneJob)
                        @Html.HiddenFor(x => x.SaveType)
                        @Html.HiddenFor(x => x.RoleID)
                        @Html.HiddenFor(x => x.CurrentRoleID)
                        @Html.HiddenFor(x => x.IsInsuranceEventByWO)
                        @Html.HiddenFor(x => x.Complete)
                        @Html.HiddenFor(x => x.DefectMgmt)
                        @Html.HiddenFor(x => x.WorkCategoryID)
                        @Html.HiddenFor(x => x.SupportDocument.SupportDocumentClassID, new { id = "SupportDocumentClassID" })
                        @Html.HiddenFor(x => x.SupportDocs)
                        @Html.HiddenFor(x => x.Comments)
                        @Html.HiddenFor(x => x.CommentsByIRCM)
                        @Html.HiddenFor(x => x.ClaimNumber)
                        @Html.HiddenFor(x => x.CORPFileNo)
                        @Html.HiddenFor(x => x.AssessorStatusID)

                        @Html.HiddenFor(x => x.CapitalDefect)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.CallLogFITSID)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.PSMDefectCallLogId)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.CompletedDate)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.CallAssignedDate)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.CallLogStatusIDForValidation)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.CapitalDefectCheckForValidation)
                        @Html.HiddenFor(x => x.CapitalDefectCompleteForValidation)
                        @Html.HiddenFor(x => x.CapitalDefectWorkAssignmentForValidation)
                        @Html.HiddenFor(x => x.CanAddEditCapitalDefect)
                        @Html.HiddenFor(x => x.UsersCanAddEditCapitalDefect)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.DefectFlaggedDate)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.DefectReversalDate)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.DefectEmailToSchoolAndPMPD)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.FirstEmailSentDate)
                        @Html.HiddenFor(x => x.CapitalDefectCalloutViewModel.LastEmailSentDate)
                        @Html.HiddenFor(x => x.ProposalId)
                        @Html.HiddenFor(x => x.ConceptEstimate)

                        @for (int i = 0; i < Model.SupportDocuments.Count; i++)
                        {
                            @Html.HiddenFor(model => Model.SupportDocuments[i], new { @value = @Html.Raw(JsonConvert.SerializeObject(Model.SupportDocuments[i])) })
                        }
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-sm-12">
                                <div class="card inner-border-1 white-bg">
                                    <div class="card-base" style="margin-bottom:-12px;">


                                        <div class="col-12">
                                            <div class="form-group">
                                                <label><strong>Callout Description </strong><span>( Max. 1000 Characters )</span><span style="vertical-align: super; color:#d7153a; ">*</span> </label>
                                                @Html.TextAreaFor(m => m.CallLogDesc, new RouteValueDictionary(new { @class = "form-control form-control-sm blue-border-1", rows = "5", style = "height:" + @callDescHeight, maxlength = 997 }).AddIf(Model.DisableField("mainSection", "CallLogDesc"), "disabled", "disabled"))
                                                @{
                                                    if (Model.DisableField("mainSection", "CallLogDesc"))
                                                    {
                                                        @Html.HiddenFor(x => x.CallLogDesc)
                                                    }
                                                }

                                                @Html.ValidationMessageFor(m => m.CallLogDesc, string.Empty, new { style = "float:none" })
                                            </div>
                                        </div>
                                        <div class="col-12" style="margin-top:-16px;">
                                            <div class="row">
                                                <div class="col-12 ">
                                                    <label><strong>Buildings Affected</strong><span style="vertical-align: super; color:#d7153a; ">*</span></label>
                                                    @Html.ListBoxFor(m => m.JobBuildingIDs, new MultiSelectList((IEnumerable<BuildingViewModel>)ViewData["BuildingsList"],
                                                    "BuildingID", "BuildingDesc", Model.JobBuildingIDs),
                                                    new RouteValueDictionary(new
                                                    {
                                                    @class = "select2 m-b-10 select2-multiple select2-hidden-accessible",
                                                    @style = "width:100%; margin-bottom: 16px;",
                                                    @onchange = "updateErrorSummary();"
                                                    }).AddIf(Model.DisableField("mainSection", "JobBuildingIDs"), "disabled", "disabled"))
                                                    @Html.ValidationMessageFor(m => m.JobBuildingIDs, string.Empty, new { style = "margin-top:0px;" })
                                                    @{
                                                        if (Model.DisableField("mainSection", "JobBuildingIDs"))
                                                        {
                                                            if (Model.JobBuildingIDs != null)
                                                            {
                                                                for (int i = 0; i < Model.JobBuildingIDs.Count; i++)
                                                                {
                                                                    @Html.HiddenFor(model => Model.JobBuildingIDs[i])
                                                                }
                                                            }

                                                        }

                                                    }
                                                    <br>
                                                    <br>
                                                </div>
                                                <div class="col-6">
                                                    <label><strong>Room No(s)</strong><span style="vertical-align: super; color:#d7153a; ">*</span></label>
                                                    <div class="form-group">
                                                        @Html.TextBoxFor(m => m.RoomNumber, new RouteValueDictionary(new { @class = "form-control form-control-sm", style = "margin-top:-2px;", @maxLength = 100, @id = "rooms" }).AddIf(Model.DisableField("mainSection", "RoomNumber"), "disabled", "disabled"))
                                                        <span class="field-validation-error" id="roomValidation" style="float:right">Rooms are required</span>
                                                        @{
                                                            if (Model.DisableField("mainSection", "RoomNumber"))
                                                            {
                                                                @Html.HiddenFor(x => x.RoomNumber)
                                                            }
                                                        }

                                                    </div>

                                                </div>
                                                <div class="col-6" style="margin-top:4px;">
                                                    <label><strong>Room Location</strong></label>
                                                    <div class="form-group">
                                                        @Html.TextBoxFor(x => x.RoomLocation, new RouteValueDictionary(new { @class = "form-control form-control-sm", style = "margin-top:-2px;", @maxLength = 50 }).AddIf(Model.DisableField("mainSection", "RoomLocation"), "disabled", "disabled"))
                                                        @{
                                                            if (Model.DisableField("mainSection", "RoomLocation"))
                                                            {
                                                                @Html.HiddenFor(x => x.RoomLocation)
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-lg-12 col-sm-12 mt-2">
                                                    <div class="row">
                                                        <div class="col-lg-12 col-md-12 col-sm-12" style="margin-top:5px;">
                                                            @Html.Partial("_AsbestosRegister")
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12" style="margin-left:-10px;height:2.5em">
                                                </div>
                                                <div id="divTotalEstimationOverLimit" class="col-12" style="margin-left:-10px;">
                                                    <div class="col-xl-6 col-lg-6 col-sm-12 float-left"><span style="font-size: 14px; font-weight: 500 !important; vertical-align: middle;"><label style="font-size: 14px; font-weight: 500 !important;">@(isTotalEstimationOverLimitLable)</label></span></div>
                                                    <div class="col-lg-6 col-sm-12 float-left">
                                                        <span class="ml-1" style="vertical-align: middle; margin-top: -5px;">
                                                            @Html.RadioButtonFor(m => m.IsTotalEstimationOverLimit, "True", new RouteValueDictionary(new { @id = "isTotalEstimationOverLimitYes", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("mainSection", "IsTotalEstimationOverLimit"), "disabled", "disabled"))
                                                            <label for="isTotalEstimationOverLimitYes" style="margin-right:10px; font-size:14px;">Yes</label>
                                                            @Html.RadioButtonFor(m => m.IsTotalEstimationOverLimit, "False", new RouteValueDictionary(new { @id = "isTotalEstimationOverLimitNo" }).AddIf(Model.DisableField("mainSection", "IsTotalEstimationOverLimit"), "disabled", "disabled"))
                                                            <label for="isTotalEstimationOverLimitNo" style="margin-left:40px; font-size:14px;font-weight: 500 !important;">No</label>
                                                            @*@Html.ValidationMessageFor(x => x.IsTotalEstimationOverLimit)*@
                                                        </span>
                                                    </div>
                                                </div>
                                                <div id="divInsuranceEvent" class="col-12" style="margin-left:-10px;">
                                                    <div class="col-xl-6 col-lg-6 col-sm-12 float-left"><span style="font-size: 14px; font-weight: 500 !important; vertical-align: middle;"><label style="font-size: 14px; font-weight: 500 !important;">Is this an Insurance Event? <span style="vertical-align: super; color:#d7153a; ">*</span></label></span></div>
                                                    <div class="col-lg-6 col-sm-12 float-left">
                                                        <span class="ml-1" style="vertical-align: middle; margin-top: -5px;">
                                                            @Html.RadioButtonFor(m => m.IsInsuranceEvent, "True", new RouteValueDictionary(new { @id = "insYes", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("mainSection", "IsInsuranceEvent"), "disabled", "disabled"))
                                                            <label for="insYes" style="margin-right:10px; font-size:14px;">Yes</label>
                                                            @Html.RadioButtonFor(m => m.IsInsuranceEvent, "False", new RouteValueDictionary(new { @id = "insNo" }).AddIf(Model.DisableField("mainSection", "IsInsuranceEvent"), "disabled", "disabled"))
                                                            <label for="insNo" style="margin-left:40px; font-size:14px;font-weight: 500 !important;">No</label>
                                                            @Html.ValidationMessageFor(x => x.IsInsuranceEvent)
                                                        </span>
                                                    </div>
                                                </div>
                                                <div id="divSecurityIncident" class="col-12" style="margin-left:-10px;">
                                                    <div class="col-xl-6 col-lg-6 col-sm-12 float-left"><span style="font-size: 14px; font-weight: 500 !important; vertical-align: middle;"><label style="font-size: 14px; font-weight: 500 !important;">Is this a security incident? <span style="vertical-align: super; color:#d7153a; ">*</span></label></span></div>
                                                    <div class="col-lg-6 col-sm-12 float-left">
                                                        <span class="ml-1" style="vertical-align: middle; margin-top: -5px;">
                                                            @Html.RadioButtonFor(m => m.IsSecurityIncident, "True", new RouteValueDictionary(new { @id = "secYes", style = "margin-left:5px; margin-right:20px;" }).AddIf(Model.DisableField("mainSection", "IsSecurityIncident"), "disabled", "disabled"))
                                                            <label for="secYes" style="margin-right:10px; font-size:14px;">Yes</label>
                                                            @Html.RadioButtonFor(m => m.IsSecurityIncident, "False", new RouteValueDictionary(new { @id = "secNo" }).AddIf(Model.DisableField("mainSection", "IsSecurityIncident"), "disabled", "disabled"))
                                                            <label for="secNo" style="margin-left:40px; font-size:14px;font-weight: 500 !important;">No</label>
                                                            @Html.ValidationMessageFor(x => x.IsSecurityIncident)
                                                        </span>
                                                    </div>
                                                </div>
                                                <input type="hidden" id="IsSecurityIncident" name="IsSecurityIncident" value="False" />

                                                @{
                                                    if (Model.IsInsuranceEventByWO == true)
                                                    {
                                                        <div class="col-12">
                                                            <div class="alert alert-info" role="alert">
                                                                Marked as Insurance Event from a Work Order.
                                                            </div>
                                                        </div>
                                                    }

                                                }
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6">
                                <div class="card inner-border-1 white-bg">
                                    <div class="card-base" style="min-height:@leftPanelHeight;">
                                        <div class="col-lg-12">
                                            <div class="row">
                                                <div class="col-lg-6 col-sm-12">
                                                    <label><strong>Date and Time Reported</strong><span style="vertical-align: super; color:#d7153a; ">*</span></label>
                                                    <div class="input-group">

                                                        @Html.EditorFor(m => m.CallDate, new
                                                   {
                                                       htmlAttributes = new RouteValueDictionary(new
                                                       {
                                                           @placeholder = "dd/mm/yyyy",
                                                           @class = "form-control form-control-sm datepicker-control",
                                                           @Value = ((Model.CallDate.HasValue) ? Model.CallDate.Value.ToString("dd/MM/yyyy") : ""),
                                                           id = "txtCallDate",

                                                       }).AddIf(Model.DisableField("mainSection", "CallDate"), "disabled", "disabled")
                                                   })
                                                        @{
                                                            if (Model.DisableField("mainSection", "CallDate"))
                                                            {
                                                                @Html.HiddenFor(x => x.CallDate)
                                                                @Html.HiddenFor(x => x.CallLogTime)

                                                            }
                                                        }
                                                        <div class="input-group-append datepicker-control-sibling" style="height: 33px;">
                                                            <span class="input-group-text mr-2" id="basic-addon1">
                                                                <img src="@Url.Content("~/theme2/assets/images/350.png")" class="datepicker-control-img" style="height:20px;">
                                                            </span>
                                                        </div>

                                                        <div class="sm-1">
                                                            <div class="row ml-2 date" id="tpIncidentFrom" data-target-input="nearest">
                                                                @{
                                                                    if (Model.DisableField("mainSection", "CallLogTime"))
                                                                    {
                                                                        <input id="CallLogTime" name="CallLogTime" type="text" class="form-control datetimepicker-input" style="width:60px" data-target="#tpIncidentFrom" Value="@((Model.CallLogTime.HasValue) ? Model.CallLogTime.Value.ToString(" HH:mm") : "" )" placeholder="" data-val-required="Callout time is required" data-val="true" readonly />

                                                                    }
                                                                    else
                                                                    {
                                                                        <input id="CallLogTime" name="CallLogTime" type="text" class="form-control datetimepicker-input dtTimeWidth" style="width:60px" data-target="#tpIncidentFrom" onchange="callLogTimeChanged();" Value="@((Model.CallLogTime.HasValue) ? Model.CallLogTime.Value.ToString(" HH:mm") : "" )" placeholder="" data-val-required="Callout Time is required" data-val="true" />
                                                                    }
                                                                    <button type="button" class="btn btn-info h-32" id="btnSetCurrentDate" style="margin-left:5px"><i class="mdi mdi-update iem" style="font-size:18px; display: flex; justify-content: center;"></i></button>

                                                                }

                                                            </div>
                                                        </div>
                                                    </div>
                                                    @{
