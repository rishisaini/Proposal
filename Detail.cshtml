          $(".agencySelector").on("click", function (e) {
            // stop anchor firing
            e.preventDefault();
            // set variables for inside the ajax post
            var aid = $(this).data("id");
            var an = $(this).data("name");
            $.ajax({
                type: "POST",
                url: "@Url.Action("SetAgency", "Home", new { area = "" })",
                data: { agencyId: aid, agencyName: an },
                success: function () {
                   window.location.href = (aid == 7061009)? '@Url.Action("Index", "Home", new {area = ""})' : "@Url.Action("Index", "CallOut", new { area = "FMWorks" })";
                }
            });
          });

